{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": [
          "./kernel/Cargo.toml"
        ],
        "cargo": {
          "target": "x86_64-unknown-none"
        },
        "check": {
          "overrideCommand": [
            "make",
            "check"
          ]
        }
      }
    }
  }
}
